APP_NAME=The State House
APP_ENV=development
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# SQLite (local default)
DATABASE_URL=sqlite+aiosqlite:///./statehouse.db

# Postgres (production / docker) — install asyncpg (in requirements)
# DATABASE_URL=postgresql+asyncpg://statehouse:statehouse@localhost:5432/statehouse

CORS_ORIGINS=http://localhost:3000,http://localhost:5173
GAME_TIME_RATIO=8
HOME_STATE_RESET_DAYS=3
STARTING_CASH=500
STARTING_AGE=18
ENERGY_REGEN_MINUTES=5
HEAT_DECAY_PER_HOUR=2.0
TRAVEL_BASE_COST=25
TRAVEL_BASE_MINUTES=20
LOAN_INTEREST_RATE=0.12
LOAN_MAX_AMOUNT=5000
LOAN_TERM_REAL_DAYS=45
MP_MIN_AGE=25
PRESIDENT_MIN_AGE=30
CABINET_REQUIRE_MP=true
MINISTER_WEEKLY_SALARY=400
CHAT_MAX_LENGTH=280
CHAT_COOLDOWN_SECONDS=10
